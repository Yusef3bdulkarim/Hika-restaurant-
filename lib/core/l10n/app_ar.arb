{
  "@@locale": "ar",
  "appTitle": "هيكا",
  "@appTitle": {
    "description": "App name shown in the OS task switcher and the placeholder screen"
  },
  "routeNotFound": "الصفحة غير موجودة",
  "@routeNotFound": {
    "description": "Shown when the app is opened on an unknown route (e.g. a broken deep link)"
  },
  "moneyAmount": "{amount}\u00A0ج.م",
  "@moneyAmount": {
    "description": "An amount in Egyptian pounds. amount is pre-formatted (Western digits, thousands comma). Keep the non-breaking space so the unit never wraps alone.",
    "placeholders": {
      "amount": {
        "type": "String",
        "example": "220"
      }
    }
  },
  "timeAm": "{time}\u00A0ص",
  "@timeAm": {
    "description": "Clock time before noon, 12h (e.g. 9:30 ص). time is pre-formatted with Western digits. Non-breaking space keeps the period on the same line.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "9:30"
      }
    }
  },
  "timePm": "{time}\u00A0م",
  "@timePm": {
    "description": "Clock time from noon, 12h (e.g. 9:30 م). time is pre-formatted with Western digits. Non-breaking space keeps the period on the same line.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "9:30"
      }
    }
  }
}
